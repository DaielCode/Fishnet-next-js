rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Łowiska: każdy czyta, tylko admin pisze
    match /lowiska/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;

      match /stanowiska/{stanowiskoId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Posty: każdy czyta, zalogowany tworzy, tylko autor edytuje/usuwa
    match /posty/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Użytkownicy: każdy czyta, tylko właściciel edytuje
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Followers
    match /followers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
