rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatary — właściciel może pisać, wszyscy czytają
    match /avatary/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Zdjęcia postów — zalogowany może pisać do swojego folderu
    match /posty/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // GeoJSON łowisk — tylko odczyt publiczny
    match /geojson/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
